generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(uuid())
  email         String?      @unique
  phone         String?      @unique
  name          String
  role          Role         @default(USER)
  language      String       @default("en")
  country       String?
  passwordHash  String?
  googleId      String?      @unique
  avatarUrl     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  // lastSeen   DateTime?   -- re-add after: ALTER TABLE "User" ADD COLUMN "lastSeen" TIMESTAMP(3);
  listings     Listing[]
  salesRep     SalesRep?
  ambassador   Ambassador?
  reviews      Review[]
  bookings     Booking[]
  microLoans   MicroLoan[]
  classifieds  Classified[]
  translationSuggestions TranslationSuggestion[]
  translationVotes       TranslationVote[]
  eventsSubmitted        Event[]
  eventAttendances       EventAttendee[]
  radioTracks            RadioTrack[]
}

enum Role {
  USER
  BUSINESS_OWNER
  SALES_REP
  AMBASSADOR
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Listing {
  id           String       @id @default(uuid())
  type         ListingType
  name         String
  phone        String?
  phone2       String?
  email        String?
  address      String?
  city         String
  country      String
  region       String?
  zipCode      String?
  latitude     Float?
  longitude    Float?
  category     String?
  subcategory  String?
  description  String?
  website      String?
  whatsapp     String?
  verified     Boolean      @default(false)
  active       Boolean      @default(true)
  viewCount    Int          @default(0)
  language     String       @default("en")
  osmId        String?      @unique
  isPro        Boolean      @default(false)
  logoUrl      String?
  photos       String[]
  openingHours String?
  avgRating      Float           @default(0)
  reviewCount    Int             @default(0)
  bookable       Boolean         @default(false)
  submittedBy    User?           @relation(fields: [submittedById], references: [id])
  submittedById  String?
  enteredBy      Ambassador?     @relation("AmbassadorListings", fields: [enteredById], references: [id])
  enteredById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tier           ListingTier     @default(SILVER)
  ads            Ad[]
  proSubscription ProSubscription?
  tags           Tag[]
  reviews        Review[]
  bookings       Booking[]
  certification  SeshaaCertification?
  awards         SeshaaAward[]
  priceEntries   PriceEntry[]
  events         Event[]
  promotions     BusinessPromotion[]

  @@index([city, country])
  @@index([category])
  @@index([phone])
  @@index([name])
}

enum ListingType {
  PERSONAL
  BUSINESS
  GOVERNMENT
  NGO
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  listing   Listing   @relation(fields: [listingId], references: [id])
  listingId String
}

model Ad {
  id              String    @id @default(uuid())
  title           String
  description     String?
  imageUrl        String?
  targetUrl       String
  advertiser      String
  contactPhone    String?
  listing         Listing?  @relation(fields: [listingId], references: [id])
  listingId       String?
  salesRep        SalesRep? @relation(fields: [salesRepId], references: [id])
  salesRepId      String?
  tier            AdTier    @default(BANNER)
  country         String?
  city            String?
  countries       String[]  // multi-country targeting
  category        String?
  targetKeywords  String[]  // keyword targeting for algorithm
  targetInterests String[]  // interest category targeting
  packageId       String?   // which preset package was used
  dailyBudget     Float?
  startDate       DateTime
  endDate         DateTime
  budget          Float
  spent           Float     @default(0)
  impressions     Int       @default(0)
  clicks          Int       @default(0)
  ctr             Float     @default(0)  // click-through rate
  active          Boolean   @default(true)
  approved        Boolean   @default(true)
  userId          String?   // advertiser user id
  createdAt       DateTime  @default(now())
  commissions     Commission[]
  impressionLogs  AdImpression[]

  @@index([tier, active])
  @@index([country, city, active])
}

model UserInterest {
  id          String   @id @default(uuid())
  userId      String?  @unique
  sessionId   String   @unique
  country     String?
  city        String?
  categories  String[]  // interested categories
  keywords    String[]  // recent search/browse terms (last 20)
  useType     String?   // "personal" | "business" | "both"
  surveyDone  Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([sessionId])
}

model AdImpression {
  id        String   @id @default(uuid())
  ad        Ad       @relation(fields: [adId], references: [id])
  adId      String
  userId    String?
  sessionId String?
  page      String?
  shownAt   DateTime @default(now())

  @@index([adId, sessionId])
  @@index([adId, userId])
}

enum AdTier {
  BANNER
  FEATURED
  SPONSORED
  PREMIUM
}

model SalesRep {
  id           String       @id @default(uuid())
  user         User         @relation(fields: [userId], references: [id])
  userId       String       @unique
  territory    String
  country      String
  commissionRate Float      @default(0.20)
  totalEarned  Float        @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  ads          Ad[]
  commissions  Commission[]
}

model Commission {
  id          String     @id @default(uuid())
  salesRep    SalesRep   @relation(fields: [salesRepId], references: [id])
  salesRepId  String
  ad          Ad         @relation(fields: [adId], references: [id])
  adId        String
  amount      Float
  rate        Float
  paid        Boolean    @default(false)
  paidAt      DateTime?
  createdAt   DateTime   @default(now())
}

// Ambassador: earns kickback by entering listings + selling Pro subscriptions
model Ambassador {
  id               String              @id @default(uuid())
  user             User                @relation(fields: [userId], references: [id])
  userId           String              @unique
  country          String
  city             String?
  listingKickback  Float               @default(0.005) // $0.005 per verified listing entered
  proKickbackRate  Float               @default(0.15)  // 15% of Pro subscription sold
  totalEarned      Float               @default(0)
  pendingPayout    Float               @default(0)
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  listingsEntered  Listing[]           @relation("AmbassadorListings")
  proSales         ProSubscription[]
  payouts          AmbassadorPayout[]
  featuredEvents   Event[]             @relation("AmbassadorFeaturedEvents")
}

model ProSubscription {
  id            String       @id @default(uuid())
  listing       Listing      @relation(fields: [listingId], references: [id])
  listingId     String       @unique
  plan          ProPlan      @default(MONTHLY)
  price         Float
  ambassador    Ambassador?  @relation(fields: [ambassadorId], references: [id])
  ambassadorId  String?
  kickback      Float        @default(0)
  active        Boolean      @default(true)
  startDate     DateTime     @default(now())
  endDate       DateTime?
  stickerCode   String?      @unique  // e.g. SESHAA-NG-AB12CD
  stickerSent   Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

enum ProPlan {
  MONTHLY
  ANNUAL
}

model AmbassadorPayout {
  id           String     @id @default(uuid())
  ambassador   Ambassador @relation(fields: [ambassadorId], references: [id])
  ambassadorId String
  amount       Float
  method       String     @default("mobile_money")
  reference    String?
  paid         Boolean    @default(false)
  paidAt       DateTime?
  createdAt    DateTime   @default(now())
}

model Review {
  id           String    @id @default(uuid())
  listing      Listing   @relation(fields: [listingId], references: [id])
  listingId    String
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  rating       Int       // 1–5
  comment      String?
  helpfulCount Int       @default(0)
  ownerReply   String?
  createdAt    DateTime  @default(now())

  @@unique([listingId, userId])
  @@index([listingId])
}

model SeshaaCertification {
  id          String     @id @default(uuid())
  listing     Listing    @relation(fields: [listingId], references: [id])
  listingId   String     @unique
  level       CertLevel  @default(STANDARD)
  awardedAt   DateTime   @default(now())
  validUntil  DateTime?
  notes       String?
}

enum CertLevel {
  STANDARD
  GOLD
  PLATINUM
}

model SeshaaAward {
  id          String   @id @default(uuid())
  listing     Listing  @relation(fields: [listingId], references: [id])
  listingId   String
  category    String   // e.g. "Best Restaurant", "Best Salon"
  city        String?
  country     String
  year        Int
  rank        Int      @default(1)
  createdAt   DateTime @default(now())

  @@unique([category, city, country, year, rank])
  @@index([country, year])
}

// Seshaa Bank — micro-loans funded by 5% of Pro subscription revenue, only for women entrepreneurs
model MicroLoan {
  id              String       @id @default(uuid())
  user            User         @relation(fields: [userId], references: [id])
  userId          String
  listingId       String?      // optional: if they own a business on the platform
  amount          Float
  purpose         String
  status          LoanStatus   @default(PENDING)
  approvedAmount  Float?
  disbursedAt     DateTime?
  repaidAt        DateTime?
  repaymentMethod String?      // mobile_money, celo, bank
  dueDate         DateTime?
  interestRate    Float        @default(0)  // 0% interest by default
  notes           String?
  createdAt       DateTime     @default(now())

  @@index([userId])
  @@index([status])
}

enum LoanStatus {
  PENDING
  APPROVED
  DISBURSED
  REPAID
  DEFAULTED
  REJECTED
}

// Seshaa Classifieds — buy/sell personal items (Craigslist-style)
model Classified {
  id          String           @id @default(uuid())
  title       String
  description String?
  price       Float
  currency    String           @default("USD")
  category    String
  condition   String           @default("USED")
  images      String[]
  city        String
  country     String
  user        User             @relation(fields: [userId], references: [id])
  userId      String
  status      ClassifiedStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([city, country])
  @@index([category])
  @@index([status])
}

enum ClassifiedStatus {
  ACTIVE
  SOLD
  EXPIRED
}

// Price Comparison — businesses list their prices for comparison
model PriceEntry {
  id        String   @id @default(uuid())
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  item      String
  price     Float
  unit      String?
  currency  String   @default("USD")
  category  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([listingId, item])
  @@index([category, item])
  @@index([listingId])
}

model Booking {
  id          String        @id @default(uuid())
  listing     Listing       @relation(fields: [listingId], references: [id])
  listingId   String
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  service     String        // e.g. "chauffeur", "catering", "beauty", "garage"
  date        DateTime
  duration    Int?          // minutes
  notes       String?
  status      BookingStatus @default(PENDING)
  totalPrice  Float?
  guestCount  Int           @default(1)
  contactName String?
  contactPhone String?
  createdAt   DateTime      @default(now())

  @@index([listingId])
  @@index([userId])
}

// ─── Listing Tiers ────────────────────────────────────────────────────────────
enum ListingTier {
  SILVER    // Free — basic name/phone/city/country
  GOLD      // $9/month — full profile, photos, hours, WhatsApp, analytics
  DIAMOND   // $19/month — featured placement, booking, QR code, priority search
}

// ─── Community Translations ───────────────────────────────────────────────────
// Ambassadors and users can suggest & vote on translations for any UI string.

model TranslationSuggestion {
  id        String   @id @default(uuid())
  lang      String   // language code e.g. "yo", "lg", "om"
  key       String   // dot-notation key e.g. "search.placeholder"
  value     String   // the suggested translation text
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  votes     Int      @default(0)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  upvotes   TranslationVote[]

  @@index([lang, key])
}

model TranslationVote {
  id           String                @id @default(uuid())
  suggestionId String
  suggestion   TranslationSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation(fields: [userId], references: [id])
  createdAt    DateTime              @default(now())

  @@unique([suggestionId, userId])
}

// ─── Crowd-sourced Events ─────────────────────────────────────────────────────
model Event {
  id            String        @id @default(uuid())
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  venue         String?
  city          String
  country       String
  latitude      Float?
  longitude     Float?
  category      String?
  imageUrl      String?
  ticketUrl     String?
  price         Float?
  currency      String        @default("USD")
  isFree        Boolean       @default(true)
  listingId     String?
  listing       Listing?      @relation(fields: [listingId], references: [id])
  submittedById String?
  submittedBy   User?         @relation(fields: [submittedById], references: [id])
  featuredById  String?
  featuredBy    Ambassador?   @relation("AmbassadorFeaturedEvents", fields: [featuredById], references: [id])
  status        EventStatus   @default(PENDING)
  views         Int           @default(0)
  attendees     EventAttendee[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([city, country])
  @@index([startDate, status])
  @@index([status])
}

enum EventStatus {
  PENDING
  APPROVED
  FEATURED
  CANCELLED
}

model EventAttendee {
  id        String   @id @default(uuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}

// ─── Business Promotions ──────────────────────────────────────────────────────
// Business owners (GOLD/DIAMOND) can post offers, deals, announcements.
model BusinessPromotion {
  id          String        @id @default(uuid())
  listing     Listing       @relation(fields: [listingId], references: [id])
  listingId   String
  type        PromotionType @default(OFFER)
  title       String
  description String?
  imageUrl    String?
  discount    Float?        // e.g. 20 for "20% off"
  couponCode  String?
  startDate   DateTime      @default(now())
  endDate     DateTime?
  active      Boolean       @default(true)
  views       Int           @default(0)
  clicks      Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([listingId, active])
  @@index([active, endDate])
}

enum PromotionType {
  OFFER        // discount / deal
  ANNOUNCEMENT // general news from the business
  HIRING       // job opening
  NEW_PRODUCT  // new product or service launch
}

// ─── Seshaa Radio — user-submitted tracks (no audio storage, just URLs) ──────
model RadioTrack {
  id            String   @id @default(uuid())
  title         String
  artist        String
  audioUrl      String                // direct stream/download URL — no file stored
  imageUrl      String?
  country       String?
  genre         String?
  album         String?
  duration      Int?                  // seconds
  ownerRights   Boolean  @default(false) // submitter confirmed they own/license the rights
  approved      Boolean  @default(false)
  playCount     Int      @default(0)
  submittedById String?
  submittedBy   User?    @relation(fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([genre, approved])
  @@index([country, approved])
  @@index([submittedById])
}

// ─── News Archive ─────────────────────────────────────────────────────────────
// Stores scraped news headlines persistently so old articles remain searchable.
// Written by archiveItems() in news.ts on every cache refresh.
model NewsArchive {
  id          String   @id @default(uuid())
  title       String
  link        String   @unique
  summary     String?
  image       String?
  source      String
  country     String
  category    String
  publishedAt DateTime
  archivedAt  DateTime @default(now())
  lang        String   @default("en")

  @@index([category, publishedAt(sort: Desc)])
  @@index([country, publishedAt(sort: Desc)])
  @@index([archivedAt(sort: Desc)])
  @@index([source])
}
