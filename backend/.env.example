# Neon PostgreSQL — get from console.neon.tech
# Pooled connection (for app queries)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/seshaa?sslmode=require&pgbouncer=true"
# Direct connection (for migrations and Prisma schema pushes)
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/seshaa?sslmode=require"

JWT_SECRET="change-me-use-openssl-rand-base64-32"
ANTHROPIC_API_KEY="sk-ant-..."

# Vercel Blob — get from vercel.com/dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

PORT=3001
NODE_ENV=development

# CORS — your Vercel frontend URL in prod
CORS_ORIGIN=http://localhost:5173
