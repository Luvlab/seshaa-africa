{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 300 }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/cron/news",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/listings",
      "schedule": "0 3 * * *"
    }
  ]
}
